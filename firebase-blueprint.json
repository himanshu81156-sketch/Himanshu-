{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public social profile for Mera Insta users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "bio": { "type": "string" },
        "avatarData": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "blockedUserIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "username", "createdAt", "updatedAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follow relationship between two users",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "followerUsername": { "type": "string" },
        "followingUsername": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Photo, Video, or Reel post",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["photo", "video", "reel"] },
        "mediaUrl": { "type": "string" },
        "filterName": { "type": "string" },
        "caption": { "type": "string" },
        "location": { "type": "string" },
        "taggedUsers": { "type": "array" },
        "musicName": { "type": "string" },
        "durationSec": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorUsername", "mediaType", "mediaUrl", "createdAt", "updatedAt"]
    },
    "Like": {
      "title": "Like",
      "description": "Post like record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Post comment record",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorUsername", "text", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour ephemeral story",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "caption": { "type": "string" },
        "filterName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorUsername", "mediaUrl", "createdAt", "expiresAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notification for follows, likes, comments, messages",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string" },
        "actorId": { "type": "string" },
        "actorUsername": { "type": "string" },
        "actorAvatar": { "type": "string" },
        "type": { "type": "string", "enum": ["follow", "like", "comment", "message"] },
        "message": { "type": "string" },
        "postId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "actorId", "actorUsername", "type", "message", "isRead", "createdAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Direct message conversation between two users",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "typingUserIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Direct message item",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "participantIds": { "type": "array" },
        "type": { "type": "string", "enum": ["text", "photo", "video", "voice"] },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "isSeen": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "participantIds", "type", "isSeen", "createdAt"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Bookmarked post or reel",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/users/{userId}/saved_posts/{postId}": {
      "schema": "SavedPost",
      "description": "Saved posts per user"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follow relationships"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Posts and Reels"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Post likes"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Post comments"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "24-hour stories"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "User notifications"
    },
    "/chats/{chatId}": {
      "schema": "ChatThread",
      "description": "DM chat threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "DM messages"
    }
  }
}
